.app-card {
  margin-top: 16rpx;
  animation: fadeInUp 0.35s ease-out both;
}

.app-header {
  margin-bottom: 16rpx;
}

.app-club-info {
  flex: 1;
}

.app-club-name {
  font-size: 24rpx;
  color: var(--primary);
  display: block;
  margin-bottom: 4rpx;
}

.app-name {
  font-size: 30rpx;
  font-weight: 600;
}

.app-status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.app-info {
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.app-field {
  display: flex;
  margin-bottom: 6rpx;
}

.app-field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 80rpx;
  flex-shrink: 0;
}

.field-value {
  font-size: 26rpx;
  color: var(--text-body);
}

.app-remark {
  font-size: 24rpx;
  color: var(--text-hint);
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}
