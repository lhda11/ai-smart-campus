.admin-section { margin-top: 24rpx; }

.admin-header {
  display: flex;
  margin-bottom: 24rpx;
}

.admin-header-text {
  flex: 1;
  margin-left: 20rpx;
}

.admin-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.admin-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.btn-rebuild {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: var(--gradient-accent);
  border-radius: var(--radius-md);
  border: none;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-elevated);
}

.btn-loading {
  opacity: 0.7;
}

.rebuild-result {
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.result-success {
  background: #EBF7EE;
  color: var(--success);
}

.result-error {
  background: #FCEDEB;
  color: var(--danger);
}

.admin-notice {
  font-size: 24rpx;
  color: var(--warning);
  padding: 16rpx;
  background: #FFF5EC;
  border-radius: var(--radius-md);
  line-height: 1.5;
}

.stats-placeholder {
  text-align: center;
  padding: 48rpx 0;
}

.stats-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}
