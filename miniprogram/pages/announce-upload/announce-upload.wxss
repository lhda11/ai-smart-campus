.upload-form { margin-top: 24rpx; }

.form-group { margin-bottom: 28rpx; }

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-body);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.label-required { color: #FF3B30; }

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  background: #F9F9F9;
  box-sizing: border-box;
}

/* 分类卡片选择 */
.category-cards {
  display: flex;
  gap: 12rpx;
}

.category-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  background: #F9F9F9;
  transition: all 0.2s;
}

.cat-active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.cat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.cat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cat-active .cat-label {
  color: var(--primary);
  font-weight: 600;
}

/* 文件选择 */
.file-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  border: 2rpx dashed #D0D0D0;
  border-radius: 16rpx;
  background: #FAFAFA;
}

.file-upload-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--primary);
  margin-bottom: 16rpx;
}

.file-placeholder-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

.file-selected {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-page);
  border-radius: 12rpx;
}

.file-type-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.file-info { flex: 1; }
.file-name { font-size: 28rpx; color: var(--text-primary); display: block; margin-bottom: 4rpx; }
.file-size { font-size: 24rpx; color: var(--text-secondary); }
.file-change { font-size: 26rpx; color: var(--primary); flex-shrink: 0; }

/* 进度条 */
.progress-wrap { margin-bottom: 24rpx; }

.progress-header {
  margin-bottom: 8rpx;
}

.progress-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.progress-percent {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.progress-bar {
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--gradient-accent);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: var(--gradient-accent);
  border-radius: var(--radius-md);
  border: none;
  box-shadow: var(--shadow-elevated);
}

.btn-disabled { opacity: 0.6; box-shadow: none; }
