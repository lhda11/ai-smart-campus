.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.club-header { margin-top: 16rpx; }
.club-header-top { display: flex; align-items: center; }

.club-logo-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.club-header-logo {
  width: 100%;
  height: 100%;
  background: var(--bg-page);
}

.club-header-info { margin-left: 24rpx; }
.club-header-name { font-size: 36rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.club-header-members { font-size: 26rpx; color: var(--text-secondary); }

.club-tags { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.club-tag {
  font-size: 24rpx; color: var(--accent); background: var(--accent-light);
  padding: 6rpx 20rpx; border-radius: 12rpx; margin-right: 12rpx; margin-bottom: 8rpx;
}

.club-desc { margin-top: 20rpx; font-size: 28rpx; line-height: 1.7; color: #555; }

.recruit-card { margin-top: 12rpx; }
.recruit-header { margin-bottom: 12rpx; }
.recruit-title { font-size: 30rpx; font-weight: 600; }
.recruit-status { font-size: 24rpx; }

.recruit-req { font-size: 26rpx; color: var(--text-secondary); margin-bottom: 16rpx; display: block; }

/* 名额进度条 */
.recruit-quota-area {
  margin-bottom: 20rpx;
}

.quota-header {
  margin-bottom: 10rpx;
}

.quota-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.quota-num {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.quota-bar {
  height: 8rpx;
  background: var(--border);
  border-radius: 4rpx;
  overflow: hidden;
}

.quota-fill {
  height: 100%;
  background: var(--gradient-accent);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.recruit-meta {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.recruit-time {
  font-size: 24rpx;
  color: var(--text-hint);
}

.btn-apply {
  font-size: 26rpx;
  color: #fff;
  background: var(--gradient-accent);
  border-radius: var(--radius-full);
  padding: 12rpx 36rpx;
  border: none;
  line-height: 1.5;
  box-shadow: var(--shadow-elevated);
}

.btn-disabled {
  background: var(--text-hint);
  color: #fff;
  box-shadow: none;
}
