.home-header {
  position: relative;
  background: var(--primary);
  color: #fff;
  padding: 40rpx 32rpx 32rpx;
  overflow: hidden;
}

.header-bg-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.deco-1 {
  width: 320rpx;
  height: 320rpx;
  top: -140rpx;
  right: -100rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.greeting-text {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}
.greeting-sub {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  display: block;
}

.header-avatar-area {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

/* 快捷功能 */
.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
}

.feature-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-card);
  position: relative;
}

.feature-icon-box {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.feature-symbol {
  font-size: 36rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.icon-box-primary {
  background: linear-gradient(135deg, rgba(224, 122, 62,0.12) 0%, rgba(224, 122, 62,0.06) 100%);
}
.icon-box-primary .feature-symbol { color: var(--primary); }

.icon-box-accent {
  background: linear-gradient(135deg, rgba(139,92,246,0.12) 0%, rgba(139,92,246,0.06) 100%);
}
.icon-box-accent .feature-symbol { color: var(--accent); }

.icon-box-orange {
  background: linear-gradient(135deg, rgba(255,149,0,0.12) 0%, rgba(255,149,0,0.06) 100%);
}
.icon-box-orange .feature-symbol { color: var(--warning); }

.icon-box-green {
  background: linear-gradient(135deg, rgba(52,199,89,0.12) 0%, rgba(52,199,89,0.06) 100%);
}
.icon-box-green .feature-symbol { color: var(--success); }

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}
.feature-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

/* Section标题 */
.section-title-bar {
  position: relative;
  padding-left: 36rpx;
}

.section-title-bar::before {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background: var(--primary);
  border-radius: 3rpx;
}

/* 快捷问题 */
.quick-section {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.quick-chip {
  font-size: 26rpx;
  color: var(--primary);
  background: var(--bg-card);
  padding: 14rpx 24rpx;
  border-radius: var(--radius-full);
  margin: 6rpx;
}

/* 公告 teaser */
.ann-teaser {
  margin-top: 8rpx;
}

.ann-teaser-row {
  display: flex;
}

.color-bar {
  width: 6rpx;
  border-radius: 3rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.color-bar-notice { background: var(--primary); }
.color-bar-activity { background: var(--warning); }
.color-bar-policy { background: var(--success); }

.ann-teaser-body {
  flex: 1;
  overflow: hidden;
}

.ann-teaser-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
}
.ann-teaser-arrow {
  font-size: 40rpx;
  color: var(--text-hint);
  flex-shrink: 0;
}
.ann-teaser-summary {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
  line-height: 1.5;
}

.ann-teaser-empty {
  text-align: center;
  padding: 32rpx;
}
.empty-teaser-row {
  display: flex;
  align-items: center;
}
.teaser-empty-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 骨架屏 */
.skeleton-area {
  padding: 0 24rpx;
}
