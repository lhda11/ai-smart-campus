<view class="page-container">
  <!-- 顶部操作区 -->
  <view class="discover-header card">
    <!-- 分段控制器 -->
    <view class="segmented-control" style="margin-bottom: 20rpx;">
      <view
        class="segmented-item {{recommendMode === 'jaccard' ? 'active' : ''}}"
        bindtap="setModeJaccard"
      >快速推荐</view>
      <view
        class="segmented-item {{recommendMode === 'ai' ? 'active' : ''}}"
        bindtap="setModeAI"
      >AI 精排</view>
    </view>

    <!-- 兴趣标签 -->
    <view class="tag-area" bindtap="openTagPicker">
      <view wx:if="{{userTags.length === 0}}" class="tag-empty-row">
        <view class="icon-box-sm icon-box-accent">
          <text>◆</text>
        </view>
        <text class="tag-placeholder">选择你的兴趣标签，发现适合的社团</text>
        <text class="tag-edit-link">选择 ›</text>
      </view>
      <block wx:else>
        <view class="tag-row">
          <text wx:for="{{userTags}}" wx:key="index" class="selected-tag">{{item}}</text>
          <text class="tag-edit">编辑</text>
        </view>
      </block>
    </view>
  </view>

  <!-- AI 推荐提示 -->
  <view wx:if="{{recommendMode === 'ai' && !loading}}" class="ai-notice">
    <text>已根据你的兴趣标签，从全部社团中筛选并智能排序</text>
  </view>

  <!-- 社团列表 -->
  <view wx:if="{{!isEmpty}}" class="club-list">
    <club-card
      wx:for="{{clubs}}"
      wx:key="id"
      club="{{item}}"
      bindtap="onClubTap"
    />
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:if="{{isEmpty && !loading}}"
    icon="◆"
    text="{{userTags.length > 0 ? '没有找到匹配的社团，试试调整标签' : '选择兴趣标签来发现适合你的社团'}}"
    subtitle="{{userTags.length > 0 ? '换个标签组合试试吧' : '标签帮助AI更好理解你的偏好'}}"
    buttonText="{{userTags.length > 0 ? '' : '选择标签'}}"
    bindaction="openTagPicker"
  />

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-center">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载社团中...</text>
  </view>
</view>

<!-- 标签选择器弹窗 -->
<view class="tag-picker-mask" wx:if="{{tagPickerVisible}}" bindtap="closeTagPicker">
  <view class="tag-picker" catchtap="">
    <view class="picker-header">
      <text class="picker-title">选择兴趣标签</text>
      <text class="picker-count">{{selectedTags.length}}/5</text>
      <text class="picker-close" bindtap="closeTagPicker">✕</text>
    </view>
    <view class="picker-grid">
      <view
        wx:for="{{allTags}}"
        wx:key="index"
        class="picker-tag {{selectedTags.indexOf(item) >= 0 ? 'tag-selected' : ''}}"
        data-tag="{{item}}"
        bindtap="toggleTag"
      >
        <text wx:if="{{selectedTags.indexOf(item) >= 0}}" class="tag-check">✓ </text>{{item}}
      </view>
    </view>
    <button class="picker-confirm press-scale" bindtap="confirmTags">确认选择</button>
  </view>
</view>
