page {
  background: var(--bg-page);
}

.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 背景：仅保留柔和渐变 ===== */
.login-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: var(--bg-page);
}

/* ===== 登录卡片 ===== */
.login-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 640rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: var(--radius-lg);
  padding: 56rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

/* ===== 按钮 ===== */
.btn-primary,
.btn-text-only {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-md);
  border: none;
  margin: 0;
  padding: 0;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-primary::after,
.btn-text-only::after {
  display: none;
}

.btn-primary {
  background: var(--gradient-accent);
  color: #fff;
  box-shadow: var(--shadow-elevated);
}

.btn-primary:active {
  box-shadow: var(--shadow-card);
}

.btn-text-only {
  background: transparent;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
  margin-top: 16rpx;
}

.btn-loading {
  opacity: 0.75;
}

/* ===== 表单 ===== */
.login-form {
  margin-bottom: 8rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-body);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.login-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-page);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.login-input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(224, 122, 62, 0.08);
}

.error-msg {
  font-size: 24rpx;
  color: var(--danger);
  margin: -8rpx 0 20rpx;
  text-align: center;
}

/* ===== 隐私协议 ===== */
.privacy-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
}

.privacy-label {
  display: flex;
  align-items: center;
}

.privacy-checkbox {
  transform: scale(0.72);
  margin-right: 4rpx;
}

.privacy-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.privacy-link {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 500;
}

/* ===== 底部 ===== */
.login-footer {
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--text-hint);
  letter-spacing: 2rpx;
}

/* ===== 动画 ===== */
.fade-in-up {
  animation: fadeInUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.fade-in {
  animation: fadeIn 0.3s ease-out both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
