<view class="page-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-card-bg">
      <view class="bg-spot bg-spot-1"></view>
      <view class="bg-spot bg-spot-2"></view>
    </view>
    <view class="user-card-content">
      <view class="user-avatar-wrap">
        <image class="user-avatar" src="{{userAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="avatar-ring"></view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userName}}</text>
        <text class="user-role">{{studentId}} · {{roleName}}</text>
      </view>
      <view class="user-edit-btn" bindtap="editProfile">
        <text>编辑</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item press-scale" bindtap="goMyApplications">
        <view class="menu-icon-box icon-box-primary">
          <text class="menu-symbol">◈</text>
        </view>
        <text class="menu-label">我的报名</text>
        <view class="menu-right">
          <text wx:if="{{applicationCount > 0}}" class="menu-badge">{{applicationCount}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item press-scale" bindtap="showTagsEdit">
        <view class="menu-icon-box icon-box-accent">
          <text class="menu-symbol">◆</text>
        </view>
        <text class="menu-label">兴趣标签</text>
        <view class="menu-right">
          <text class="menu-value">{{userTagsPreview}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item press-scale" bindtap="goAdmin">
        <view class="menu-icon-box icon-box-gray">
          <text class="menu-symbol">◎</text>
        </view>
        <text class="menu-label">管理工具</text>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item press-scale" bindtap="showAbout">
        <view class="menu-icon-box icon-box-green">
          <text class="menu-symbol">◉</text>
        </view>
        <text class="menu-label">关于</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本 -->
  <view class="version-info">
    <text>长春师范大学 · 校园助手 v1.0.0</text>
  </view>

  <!-- 退出登录 -->
  <view class="logout-row">
    <text class="logout-btn press-scale" bindtap="logout">退出登录</text>
  </view>
</view>
