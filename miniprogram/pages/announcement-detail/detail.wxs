var CATEGORY_MAP = {
  notice: { label: '通知', color: 'badge-notice' },
  activity: { label: '活动', color: 'badge-activity' },
  policy: { label: '制度', color: 'badge-policy' }
};

function categoryLabel(cat) {
  return (CATEGORY_MAP[cat] || { label: cat }).label;
}
function categoryColor(cat) {
  return (CATEGORY_MAP[cat] || { color: 'badge-notice' }).color;
}
function formatTime(isoStr) {
  if (!isoStr) return '';
  var d = getDate(isoStr.replace('T', ' ').substring(0, 19));
  var now = getDate();
  var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
  var time = pad(d.getHours()) + ':' + pad(d.getMinutes());
  var isToday = d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth() && d.getDate() === now.getDate();
  if (isToday) return time;
  var yesterday = getDate(now.getTime() - 86400000);
  var isYesterday = d.getFullYear() === yesterday.getFullYear() && d.getMonth() === yesterday.getMonth() && d.getDate() === yesterday.getDate();
  if (isYesterday) return '昨天 ' + time;
  var ds = pad(d.getMonth()+1) + '-' + pad(d.getDate());
  if (d.getFullYear() === now.getFullYear()) return ds + ' ' + time;
  return d.getFullYear() + '-' + ds + ' ' + time;
}

module.exports = {
  categoryLabel: categoryLabel,
  categoryColor: categoryColor,
  formatTime: formatTime
};
