.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.error-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx;
}

.error-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFF5EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 24rpx;
}

.error-msg {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.detail-card {
  margin-top: 16rpx;
}

.detail-header {
  border-bottom: 1rpx solid var(--border);
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
}

.detail-category-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.detail-time {
  font-size: 24rpx;
  color: var(--text-hint);
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  line-height: 1.4;
}

.detail-content {
  font-size: 32rpx;
  line-height: 2.0;
  color: var(--text-body);
  white-space: pre-wrap;
  word-break: break-all;
  margin-bottom: 24rpx;
}

.detail-file {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-page);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.file-type-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.file-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--primary);
}

.file-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
}

.detail-actions {
  display: flex;
  justify-content: flex-end;
}

.btn-delete {
  font-size: 26rpx;
  color: #fff;
  background: #FF3B30;
  border-radius: 8rpx;
  padding: 12rpx 36rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(255, 59, 48, 0.2);
}
