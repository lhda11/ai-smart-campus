.msg-wrapper {
  display: flex;
  margin-bottom: 28rpx;
  padding: 0 24rpx;
}

.msg-user { justify-content: flex-end; }
.msg-assistant { justify-content: flex-start; align-items: flex-end; }

.msg-content {
  display: flex;
  flex-direction: column;
  max-width: 76%;
}

.user-content { align-items: flex-end; }
.assistant-content { align-items: flex-start; margin-left: 16rpx; }

.bubble-avatar {
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

.msg-system {
  align-self: center;
  max-width: 80%;
  background: var(--bg-card-soft);
  border-radius: var(--radius-full);
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  margin: 0 auto;
}

.msg-bubble {
  padding: 22rpx 30rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}

.bubble-user {
  background: var(--gradient-brand);
  color: #fff;
}

.bubble-assistant {
  background: var(--bg-card);
  color: var(--text-primary);
  box-shadow: var(--shadow-card);
}

.msg-time {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  padding: 0 4rpx;
}

/* 消息脚注行（时间 + 复制） */
.msg-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
  padding: 0 4rpx;
}

.user-content .msg-footer {
  justify-content: flex-end;
}

.assistant-content .msg-footer {
  justify-content: flex-start;
}

.msg-copy-btn {
  font-size: 20rpx;
  color: var(--text-hint);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
}

.msg-copy-btn:active {
  background: var(--bg-card-soft);
}

/* Markdown 样式 */
.md-paragraph { margin-bottom: 4rpx; }
.md-heading { font-size: 32rpx; font-weight: 700; margin: 14rpx 0 8rpx; }
.md-list-item { padding-left: 16rpx; margin: 6rpx 0; }
.md-list-item::before { content: "• "; color: var(--text-secondary); }

.md-bold { font-weight: 700; }
.md-italic { font-style: italic; }

.md-inline-code {
  font-family: monospace;
  background: rgba(0,0,0,0.05);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 26rpx;
}

.bubble-user .md-inline-code {
  background: rgba(255,255,255,0.25);
}

.md-code-block {
  background: #2D2D2D;
  color: #E6DB74;
  border-radius: var(--radius-md);
  padding: 18rpx 22rpx;
  margin: 10rpx 0;
  font-family: monospace;
  font-size: 24rpx;
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-all;
}

.bubble-user .md-code-block {
  background: rgba(0,0,0,0.2);
  color: #fff;
}

.md-br { height: 12rpx; }

/* 打字机光标 */
.typing-cursor {
  animation: blink 1s step-end infinite;
  color: var(--primary);
  font-weight: bold;
}

.bubble-user .typing-cursor {
  color: #fff;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
