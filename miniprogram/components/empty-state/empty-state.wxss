.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
}

.empty-icon-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF8F0, var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-symbol {
  font-size: 64rpx;
  line-height: 1;
}

.pulse {
  animation: pulse 2.5s ease-in-out infinite;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-btn {
  margin-top: 16rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  color: #fff;
  background: var(--gradient-accent);
  border-radius: var(--radius-full);
  border: none;
  box-shadow: var(--shadow-elevated);
}
