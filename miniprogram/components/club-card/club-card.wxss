.club-card {
  margin: 16rpx 24rpx;
  transition: transform 0.15s ease;
}

.club-card:active {
  transform: scale(0.98);
}

.club-top {
  display: flex;
  align-items: center;
}

.club-logo-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.club-logo {
  width: 100%;
  height: 100%;
  background: var(--bg-page);
}

.club-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.club-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.club-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.club-arrow {
  font-size: 40rpx;
  color: var(--text-hint);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.club-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.club-tag {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.club-bottom {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.club-members {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.club-recruit-badge {
  font-size: 22rpx;
  color: var(--success);
  background: #EBF7EE;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

.pulse-text {
  animation: pulse 2s ease-in-out infinite;
}
