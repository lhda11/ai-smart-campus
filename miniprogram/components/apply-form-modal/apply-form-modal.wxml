<view class="modal-mask" wx:if="{{visible}}" bindtap="onClose">
  <view class="modal-content" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">报名 {{clubName}}</text>
      <view class="modal-close" bindtap="onClose">✕</view>
    </view>

    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">姓名 *</text>
        <input
          class="form-input {{errors.name ? 'input-error' : ''}}"
          placeholder="请输入真实姓名"
          value="{{form.name}}"
          data-field="name"
          bindinput="onInput"
          maxlength="50"
        />
        <text wx:if="{{errors.name}}" class="error-text">{{errors.name}}</text>
      </view>

      <view class="form-group">
        <text class="form-label">学号 *</text>
        <input
          class="form-input {{errors.studentId ? 'input-error' : ''}}"
          placeholder="请输入学号"
          value="{{form.studentId}}"
          data-field="studentId"
          bindinput="onInput"
          type="number"
        />
        <text wx:if="{{errors.studentId}}" class="error-text">{{errors.studentId}}</text>
      </view>

      <view class="form-group">
        <text class="form-label">手机号 *</text>
        <input
          class="form-input {{errors.phone ? 'input-error' : ''}}"
          placeholder="请输入手机号"
          value="{{form.phone}}"
          data-field="phone"
          bindinput="onInput"
          type="number"
          maxlength="11"
        />
        <text wx:if="{{errors.phone}}" class="error-text">{{errors.phone}}</text>
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn-cancel" bindtap="onClose">取消</button>
      <button class="btn-submit {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '确认报名'}}
      </button>
    </view>
  </view>
</view>
